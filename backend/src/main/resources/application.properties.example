spring.application.name=medipulse-backend
spring.datasource.url=${DB_URL:jdbc:mysql://localhost:3306/medipulse}
spring.datasource.username=${DB_USERNAME:root}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.jpa.hibernate.ddl-auto=${DDL_AUTO:update}
spring.jpa.show-sql=${SHOW_SQL:false}
spring.jpa.open-in-view=false
spring.flyway.enabled=false
app.jwt.secret=${JWT_SECRET}
app.jwt.expiration-ms=${JWT_EXPIRATION_MS:3600000}
app.jwt.refresh-expiration-ms=${JWT_REFRESH_EXPIRATION_MS:604800000}
app.demo-data-enabled=${DEMO_DATA_ENABLED:true}
app.alerts.mail-enabled=${ALERT_MAIL_ENABLED:false}
app.alerts.smtp-host=${SMTP_HOST:}
app.alerts.smtp-port=${SMTP_PORT:587}
app.alerts.smtp-ssl=${SMTP_SSL:false}
app.alerts.smtp-starttls=${SMTP_STARTTLS:true}
app.alerts.smtp-username=${SMTP_USERNAME:}
app.alerts.smtp-password=${SMTP_PASSWORD:}
app.alerts.mail-from=${ALERT_MAIL_FROM:MediPulse <noreply@medipulse.local>}
app.alerts.mail-cooldown-minutes=${ALERT_MAIL_COOLDOWN_MINUTES:60}
app.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5500,http://127.0.0.1:5500}
server.port=${SERVER_PORT:8080}
app.upload.dir=${UPLOAD_DIR:uploads/lab-reports}
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
